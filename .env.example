# Optional: OpenAI API key for LLM-enhanced extraction and scoring
# Only needed if LLM_ENABLED=true
OPENAI_API_KEY=

# Set to "true" to enable LLM-assisted resume extraction and scoring
# Default: false (purely deterministic pipeline)
LLM_ENABLED=false

# Model to use for LLM features (when LLM_ENABLED=true)
LLM_MODEL=gpt-4o-mini

# Optional: GitHub Personal Access Token for higher rate limits
# Without a token, GitHub API allows ~60 requests/hour
GITHUB_TOKEN=
